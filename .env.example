# Keys of the sales unit, from the business portal (Developer section).
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
# Merchant-Serial-Number of the sales unit (4-10 digits).
VIPPS_MERCHANT_SERIAL_NUMBER=
# test (apitest.vipps.no) or production (api.vipps.no).
VIPPS_ENVIRONMENT=test
# merchant (the sales unit's own keys) or partner (production only; no Report API tools).
VIPPS_KEY_TYPE=merchant
# Override for a local mock only (loopback, or api.vipps.no / apitest.vipps.no over https).
# VIPPS_BASE_URL=http://127.0.0.1:8080
# VIPPS_ALLOW_CUSTOM_BASE_URL=false
VIPPS_TIMEOUT_MS=30000
VIPPS_MAX_CONCURRENCY=4
# Largest response body read from the API (bytes, max 104857600).
VIPPS_MAX_RESPONSE_BYTES=10485760

# Write tools (capture, refund, cancel) are disabled unless this is true.
VIPPS_ENABLE_WRITES=false
# Comma-separated tool names to disable (with or without the vipps_ prefix).
VIPPS_DISABLED_TOOLS=
# JSONL audit trail; write tools refuse to run if it cannot be written.
VIPPS_AUDIT_LOG=

# HTTP transport. A bearer token (>= 32 printable ASCII characters, e.g.
# `openssl rand -hex 32`) is required unless the server binds to loopback.
MCP_HTTP_TOKEN=
# Bind address (HOST is also read; MCP_HTTP_HOST wins):
# MCP_HTTP_HOST=127.0.0.1
# PORT=3000
# MCP_ALLOWED_ORIGINS=
# MCP_ALLOWED_HOSTS=
# MCP_MAX_BODY_BYTES=10485760
# MCP_AUTH_FAILURE_LIMIT=20
# MCP_AUTH_FAILURE_WINDOW_MS=60000
# Allow any browser origin (requires a token):
# MCP_ALLOW_ANY_ORIGIN=false
# Non-loopback bind without a token; isolated networks only:
# MCP_HTTP_ALLOW_UNAUTHENTICATED=false
